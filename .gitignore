PLAN.md
.DS_Store
node_modules/

# Provider-patch local deps
dotfiles/pi/.pi/agent/extensions/provider-patch/node_modules/

# npm lock file — machine-specific paths, managed by pi at runtime
dotfiles/pi/.pi/agent/npm/package-lock.json
dotfiles/pi/.pi/*/sessions/*
dotfiles/pi/.pi/*/auth*

# Broad safety net
**/auth.json
**/.pi/agent/sessions/
**/.pi/agent/stats.db*
**/.pi/agent/run-history.jsonl
**/.pi/web-search-cache/

# PI stats database
dotfiles/pi/.pi/agent/stats.db-wal
dotfiles/pi/.pi/agent/stats.db-shm
dotfiles/pi/.pi/agent/stats.db

# PI run history
dotfiles/pi/.pi/agent/run-history.jsonl
**/.pi/agent/*.log

# pi-subagents chain/run artifacts
.pi-subagents/
dotfiles/git/.gitconfig
dotfiles/pi/.pi/agent/trust.json

**/.pi/agent/mcp-auth.json

# pi-managed caches
**/.pi/agent/models-store.json
**/.pi/agent/web-search-cache/

# pi-stats database
**/.pi/agent/pi-stats.db*

# Active theme pointers, generated by scripts/toggle-theme.sh
dotfiles/ghostty/.config/ghostty/theme
dotfiles/tmux/.config/tmux/theme.conf
dotfiles/lazygit/.config/lazygit/theme.yml
dotfiles/pi/.pi/agent/themes/current.json
