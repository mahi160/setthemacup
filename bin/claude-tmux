#!/usr/bin/env python3
"""
Claude usage widget for tmux status bar — palette follows ~/.config/theme, 5-min cache.
Uses pi's Claude Pro/Max OAuth login (~/.pi/agent/auth.json, key "anthropic"), so no setup.

Usage in tmux.conf:
  set -g status-right '#(~/.local/bin/claude-tmux)'
  # status-interval 5 is fine — output is cached to /tmp/.claude-status-cache
"""

from __future__ import annotations  # macOS python3 is 3.9: no `str | None` at runtime

import json
import os
import time
import urllib.error
import urllib.request

# ── Config ────────────────────────────────────────────────────────────────────

AUTH_FILE  = os.path.expanduser("~/.pi/agent/auth.json")
USAGE_URL  = "https://api.anthropic.com/api/oauth/usage"
CACHE_FILE = "/tmp/.claude-status-cache"
CACHE_TTL  = 300  # seconds — actual API calls at most once per 5 min

# ── Palette (gruvbox | kanagawa-wave | everforest) ─────────────────────────────────────────────────────

def _theme() -> str:
    try:
        with open(os.path.expanduser("~/.config/theme")) as f:
            return f.read().strip()
    except OSError:
        return "kanagawa-wave"

if _theme() == "gruvbox":
    C_GREEN  = "#a9b665"   # green
    C_YELLOW = "#d8a657"   # yellow
    C_RED    = "#ea6962"   # red
    C_PURPLE = "#d3869b"   # purple
    C_GRAY   = "#928374"   # gray
elif _theme() == "everforest":
    C_GREEN  = "#a7c080"   # green
    C_YELLOW = "#dbbc7f"   # yellow
    C_RED    = "#e67e80"   # red
    C_PURPLE = "#d699b6"   # purple
    C_GRAY   = "#859289"   # grey1
else:
    C_GREEN  = "#98BB6C"   # springGreen
    C_YELLOW = "#E6C384"   # carpYellow
    C_RED    = "#E82424"   # samuraiRed
    C_PURPLE = "#957fb8"   # oniViolet
    C_GRAY   = "#727169"   # fujiGray

# ── Helpers ───────────────────────────────────────────────────────────────────

def fg(color: str, text: str) -> str:
    return f"#[fg={color}]{text}#[fg=default]"

def usage_color(pct: float) -> str:
    if pct < 60: return C_GREEN
    if pct < 80: return C_YELLOW
    return C_RED

def session_icon(pct: float) -> str:
    """Pie-fill circle representing 5-hour window usage."""
    if pct < 20: return "○"
    if pct < 40: return "◔"
    if pct < 60: return "◑"
    if pct < 80: return "◕"
    return "●"

def gradient_bar(pct: float, width: int = 8) -> str:
    """
    Traffic-light bar: each segment is colored by its position in the bar,
    not by overall utilisation — so the bar always shows green → yellow → red
    and the fill level shows how much is used.

    Example at 62%:   ▰▰▰▰▰▱▱▱   (green×3, yellow×2, gray×3)
    Example at 85%:   ▰▰▰▰▰▰▰▱   (green×3, yellow×2, red×2, gray×1)
    """
    filled = round(pct / 100 * width)
    out = ""
    for i in range(width):
        cell_pct = (i + 1) / width * 100   # position within full bar
        if i < filled:
            if cell_pct <= 60: color = C_GREEN
            elif cell_pct <= 80: color = C_YELLOW
            else: color = C_RED
            out += f"#[fg={color}]▰"
        else:
            out += f"#[fg={C_GRAY}]▱"
    return out + "#[fg=default]"

def render(five_h: float, seven_d: float) -> str:
    """
    Layout:  ✦  ◑ 45%  ▰▰▰▰▰▰▱▱  72%
             │  │ └5h%  └── 7d gradient bar ─┘  └7d%
             │  └session fill icon
             └spark icon (purple)
    """
    icon    = fg(C_PURPLE, "✦")
    session = fg(usage_color(five_h), f"{session_icon(five_h)} {five_h:.0f}%")
    bar     = gradient_bar(seven_d)
    weekly  = fg(usage_color(seven_d), f"{seven_d:.0f}%")
    sep     = fg(C_GRAY, "│")

    return f" {icon}  {session}  {sep}  {bar}  {weekly} "

# ── Keychain ──────────────────────────────────────────────────────────────────

def pi_token() -> str | None:
    """pi's Anthropic OAuth access token; None if missing or expired."""
    try:
        with open(AUTH_FILE) as f:
            cred = json.load(f).get("anthropic") or {}
    except (OSError, ValueError):
        return None
    if cred.get("type") != "oauth" or cred.get("expires", 0) <= time.time() * 1000:
        return None
    return cred.get("access")

# ── Fetch ─────────────────────────────────────────────────────────────────────

def fetch() -> str:
    # ponytail: never refreshes token (would rotate pi's refresh token); pi refreshes it on use
    token = pi_token()
    if not token:
        return fg(C_RED, "✦ ⚠ pi login")

    try:
        req = urllib.request.Request(
            USAGE_URL,
            headers={
                "Authorization": f"Bearer {token}",
                "anthropic-beta": "oauth-2025-04-20",
            },
        )
        with urllib.request.urlopen(req, timeout=5) as r:
            data = json.loads(r.read())
    except urllib.error.HTTPError as e:
        return fg(C_RED, f"✦ ⚠ {e.code}")
    except urllib.error.URLError:
        return fg(C_RED, "✦ ⚠ offline")
    except Exception as e:
        return fg(C_RED, f"✦ ⚠ {type(e).__name__}")

    five_h  = (data.get("five_hour") or {}).get("utilization") or 0.0
    seven_d = (data.get("seven_day") or {}).get("utilization") or 0.0
    return render(five_h, seven_d)

# ── Cache ─────────────────────────────────────────────────────────────────────

def read_cache() -> str | None:
    try:
        age = time.time() - os.path.getmtime(CACHE_FILE)
        if age < CACHE_TTL:
            with open(CACHE_FILE) as f:
                return f.read()
    except OSError:
        pass
    return None

def write_cache(result: str) -> None:
    tmp = CACHE_FILE + ".tmp"
    try:
        with open(tmp, "w") as f:
            f.write(result)
        os.replace(tmp, CACHE_FILE)
    except OSError:
        pass

# ── Main ──────────────────────────────────────────────────────────────────────

def main() -> None:
    cached = read_cache()
    if cached is not None:
        print(cached, end="")
        return

    result = fetch()
    write_cache(result)
    print(result, end="")

if __name__ == "__main__":
    main()
