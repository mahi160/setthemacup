#!/usr/bin/env bash
# pokemon-bg [id] — swap the Ghostty background to a random (or given) Pokemon.
# Downloads official artwork to ~/Pictures/pokemon_bg and repoints current.png.

set -euo pipefail

POKEMON_DIR="${HOME}/Pictures/pokemon_bg"
MAX_POKEMON=1025

mkdir -p "$POKEMON_DIR"

# Pick a specific ID if passed as arg, otherwise random
if [[ -n "${1:-}" ]]; then
  if [[ ! "${1}" =~ ^[0-9]+$ ]] || (( ${1} < 1 || ${1} > MAX_POKEMON )); then
    printf "Error: Pokemon ID must be an integer between 1 and %d\n" "$MAX_POKEMON" >&2
    exit 1
  fi
  POKEMON_ID="$1"
else
  POKEMON_ID=$(( RANDOM % MAX_POKEMON + 1 ))
fi

IMAGE_PATH="${POKEMON_DIR}/${POKEMON_ID}.png"

# Download official artwork if not cached
if [[ ! -f "$IMAGE_PATH" ]]; then
  printf "Fetching Pokemon #%d...\n" "$POKEMON_ID"
  curl -sL --fail \
    "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${POKEMON_ID}.png" \
    -o "$IMAGE_PATH" \
    || { printf "Failed to download Pokemon #%d\n" "$POKEMON_ID" >&2; rm -f "$IMAGE_PATH"; exit 1; }
  sips -z 1000 1000 "$IMAGE_PATH" --out "$IMAGE_PATH" >/dev/null 2>&1
fi

# Update current.png symlink — used by fastfetch logo and nvim dashboard
ln -sf "$IMAGE_PATH" "${POKEMON_DIR}/current.png"

# Ghostty's background-image points at current.png; reload so it picks up the new target
if pgrep -xq ghostty; then
  osascript \
    -e 'tell application "Ghostty" to activate' \
    -e 'tell application "System Events" to keystroke "," using {command down, shift down}' \
    >/dev/null 2>&1 || echo "ghostty: press cmd+shift+, to reload" >&2
fi

printf "Pokemon #%d\n" "$POKEMON_ID"