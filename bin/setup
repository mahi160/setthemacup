#!/usr/bin/env bash
# setup — run the setthemacup installer. See `setup --help`.
set -euo pipefail

repo="${SETTHEMACUP:-$HOME/.setup}"
node_bin="$(command -v node || true)"
[[ -n "$node_bin" ]] || node_bin="$HOME/.local/share/fnm/aliases/default/bin/node"
[[ -x "$node_bin" ]] || { echo "setup: node not found — run bootstrap.sh first" >&2; exit 1; }

[[ -d "$repo/installer/node_modules" ]] || (cd "$repo/installer" && pnpm install --frozen-lockfile --prod --silent)
exec "$node_bin" "$repo/installer/src/index.ts" "$@"
