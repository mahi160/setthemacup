#!/usr/bin/env bash
# vpn — connect to a FortiGate VPN with SAML/SSO via openfortivpn, in the background.
# Runs on macOS and on Linux with systemd-resolved (Ubuntu).
#
# Usage:
#   vpn            pick a gateway with fzf
#   vpn <name>     connect by name (e.g. vpn pune); returns once connected
#   vpn status     show the connection
#   vpn stop       disconnect
#
# Gateways: ~/.config/setthemacup/vpn-gateways (private repo), one per line:
#   <name> <host:port> [routes=<cidr>,...] [domains=<domain>,...]
# routes=  split tunnel: only these networks use the VPN (gateway routes ignored)
# domains= extra domains to resolve through the VPN's DNS
#
# How it works:
#   1. You pick a gateway; sudo starts this same script as root in the background (`--run`).
#   2. The root side runs `openfortivpn --saml-login`, which waits for the SSO callback
#      on 127.0.0.1:8020. You open the gateway's SAML page; after login it redirects there.
#   3. When the log says "Tunnel is up", the root side adds split routes and DNS, then
#      prints "vpn: ready". openfortivpn only writes /etc/resolv.conf, which macOS ignores,
#      so DNS goes to configd with scutil (check with `scutil --dns`). On Linux,
#      openfortivpn runs with --no-dns and DNS goes to the ppp link with resolvectl
#      (check with `resolvectl status`); resolved drops it when the link goes down.
#   4. `vpn stop` sends TERM to the root side; it forwards it to openfortivpn, which logs
#      out. On exit the root side restores DNS.
# Runtime files (log, name, pid) live in $TMPDIR/setthemacup-vpn.

set -euo pipefail

OS="$(uname -s)"

DNS_KEY="State:/Network/Service/setthemacup-vpn/DNS"
BACKUP_KEY="State:/Network/setthemacup-vpn/SetupDNS"

# ppp interface from the openfortivpn log
tunnel_if() {
  local i
  i="$(sed -nE 's/.*Interface (ppp[0-9]+) is UP.*/\1/p' "$1" | head -1)"
  echo "${i:-ppp0}"
}

# ── Root side: vpn --run <dir> <openfortivpn> <gateway> <routes> <domains> ──
# sudo's secure_path may pick /bin/bash 3.2: keep this part 3.2-safe (no empty arrays).

# "Got addresses: [ip], ns [a, b], ns_suffix [x;y]" → items of ns / ns_suffix
log_list() {
  grep -m1 'Got addresses:' "$LOG" | sed -nE "s/.*$1 \[([^]]*)\].*/\1/p" | tr ',;' '  '
}

add_routes() {
  [[ -n $ROUTES ]] || return 0
  local ifname r
  ifname="$(tunnel_if "$LOG")"
  for r in $ROUTES; do
    if [[ $OS == Linux ]]; then
      ip route add "$r" dev "$ifname" || echo "vpn: route $r failed"
    else
      route -q -n add -net "$r" -interface "$ifname" || echo "vpn: route $r failed"
    fi
  done
  echo "vpn: split tunnel via VPN: $ROUTES"
}

# Split tunnel: macOS asks the VPN's DNS only for these domains
dns_split() {
  scutil <<EOF
d.init
d.add ServerAddresses * $1
d.add SearchDomains * $2
d.add SupplementalMatchDomains * $2
set $DNS_KEY
EOF
}

# Full tunnel: every lookup goes to the VPN's DNS. Setup: beats DHCP values and survives
# lease renewals; the old Setup: DNS (manual DNS, if any) is backed up for dns_down
dns_full() {
  PRIMARY="$(scutil <<<"show State:/Network/Global/IPv4" | awk '/PrimaryService/{print $3}')"
  [[ -n $PRIMARY ]] || { echo "vpn: no primary network service; DNS unchanged"; return 1; }
  scutil <<EOF
d.init
get Setup:/Network/Service/$PRIMARY/DNS
set $BACKUP_KEY
d.init
d.add ServerAddresses * $1
${2:+d.add SearchDomains * $2}
set Setup:/Network/Service/$PRIMARY/DNS
EOF
}

# Linux: per-link DNS in systemd-resolved; full tunnel ($3=1) routes every lookup there
dns_resolved() {
  local ifname
  ifname="$(tunnel_if "$LOG")"
  resolvectl dns "$ifname" $1
  if [[ $3 == 1 ]]; then
    resolvectl domain "$ifname" '~.' $2
    resolvectl default-route "$ifname" yes
  else
    resolvectl domain "$ifname" $2
    resolvectl default-route "$ifname" no
  fi
}

full_tunnel() {
  if [[ $OS == Linux ]]; then
    ip route get 1.1.1.1 2>/dev/null | grep -q 'dev ppp'
  else
    route -n get default 2>/dev/null | grep -q 'interface: ppp'
  fi
}

dns_up() {
  local ns="" suffix="" n full=0
  for n in $(log_list ns); do [[ $n == 0.0.0.0 ]] || ns+="$n "; done
  for n in $(log_list ns_suffix); do [[ $n == "(null)" ]] || suffix+="$n "; done
  suffix+="$DOMAINS"
  [[ -n $ns ]] || { echo "vpn: no DNS servers in openfortivpn output; DNS unchanged"; return 0; }

  if full_tunnel; then full=1; fi
  if [[ $full == 0 && -z $suffix ]]; then
    echo "vpn: split tunnel without DNS suffix; DNS unchanged"
    return 0
  fi

  if [[ $OS == Linux ]]; then
    dns_resolved "$ns" "$suffix" "$full"
  elif [[ $full == 1 ]]; then
    dns_full "$ns" "$suffix" || return 0
  else
    dns_split "$ns" "$suffix"
  fi
  echo "vpn: DNS → ${ns}${suffix:+(search: $suffix)}"
}

dns_down() {
  [[ $OS == Darwin ]] || return 0
  scutil <<<"remove $DNS_KEY" >/dev/null 2>&1 || true
  [[ -n $PRIMARY ]] || return 0
  # Empty backup = no manual DNS before; removing Setup: falls back to DHCP DNS
  if scutil <<<"show $BACKUP_KEY" | grep -q ServerAddresses; then
    scutil <<<"d.init
get $BACKUP_KEY
set Setup:/Network/Service/$PRIMARY/DNS" || true
  else
    scutil <<<"remove Setup:/Network/Service/$PRIMARY/DNS" || true
  fi
  scutil <<<"remove $BACKUP_KEY" || true
}

ofv_alive() { kill -0 "$OFPID" 2>/dev/null; }

root_cleanup() {
  set +e
  dns_down
  rm -f "$DIR/pid"
  echo "vpn: disconnected"
}

root_main() {
  DIR=$1 OFV=$2 GATEWAY=$3 ROUTES=$4 DOMAINS=$5
  LOG="$DIR/log" OFPID="" PRIMARY=""
  trap root_cleanup EXIT
  # `vpn stop` sends TERM here; forward it so openfortivpn logs out cleanly
  trap 'kill -TERM "$OFPID" 2>/dev/null || true' TERM INT

  # 1. Start openfortivpn; split tunnels skip the gateway's routes
  local flags="--saml-login"
  [[ -z $ROUTES ]] || flags+=" --set-routes=0"
  [[ $OS != Linux ]] || flags+=" --no-dns"
  "$OFV" "$GATEWAY" $flags </dev/null &
  OFPID=$!
  # Published only now, so a stop signal always has openfortivpn to forward to
  echo $$ >"$DIR/pid"

  # 2. Wait for the browser login to bring the tunnel up
  until grep -q 'Tunnel is up' "$LOG"; do
    ofv_alive || exit 0
    sleep 1
  done

  # 3. Routes + DNS
  add_routes
  dns_up || echo "vpn: DNS setup failed"
  echo "vpn: ready"

  # 4. Stay until openfortivpn exits; a trapped signal interrupts wait, so loop
  while ofv_alive; do wait "$OFPID" || true; done
}

# ── User side ──
DIR="${TMPDIR:-/tmp}"
DIR="${DIR%/}/setthemacup-vpn"
GATEWAYS="$HOME/.config/setthemacup/vpn-gateways"

running() {
  [[ -s $DIR/pid ]] && ps -p "$(cat "$DIR/pid")" -o command= 2>/dev/null | grep -q -- '--run'
}

fail() {
  echo "vpn: $1:" >&2
  tail -n 15 "$DIR/log" >&2
  exit 1
}

status() {
  running || { echo "vpn: disconnected"; return 1; }
  local name ifname ip
  name="$(cat "$DIR/name")"
  if ! grep -q 'Tunnel is up' "$DIR/log"; then
    echo "vpn: $name connecting (waiting for browser login)"
    return 0
  fi
  ifname="$(tunnel_if "$DIR/log")"
  if [[ $OS == Linux ]]; then
    ip="$(ip -4 -o addr show dev "$ifname" 2>/dev/null | awk '{print $4}' || true)"
  else
    ip="$(ifconfig "$ifname" 2>/dev/null | awk '/inet /{print $2}' || true)"
  fi
  echo "vpn: $name connected, up $(ps -p "$(cat "$DIR/pid")" -o etime= | tr -d ' ')"
  echo "  interface: $ifname ${ip:-?}"
  grep -E '^vpn: (split|DNS|no DNS)' "$DIR/log" | sed 's/^vpn: /  /' || true
}

stop() {
  running || { echo "vpn: not connected"; return 0; }
  sudo kill -TERM "$(cat "$DIR/pid")"
  for _ in {1..30}; do
    running || { echo "vpn: disconnected"; return 0; }
    sleep 0.5
  done
  echo "vpn: still stopping; see $DIR/log" >&2
  return 1
}

# Sets NAME GATEWAY ROUTES DOMAINS from the gateways file (by name, or fzf)
pick() {
  local entries line opts opt
  [[ -f $GATEWAYS ]] || { echo "No gateways file: $GATEWAYS" >&2; exit 1; }
  entries="$(grep -vE '^[[:space:]]*(#|$)' "$GATEWAYS")"
  if [[ -n ${1:-} ]]; then
    line="$(awk -v n="$1" 'tolower($1) == tolower(n)' <<<"$entries")"
  else
    line="$(fzf --prompt='vpn> ' --height=~10 --reverse <<<"$entries" || true)"
  fi
  [[ -n $line ]] || { echo "No gateway selected." >&2; exit 1; }

  read -r NAME GATEWAY opts <<<"$line"
  ROUTES="" DOMAINS=""
  for opt in $opts; do
    case $opt in
      routes=*) ROUTES="${opt#routes=}" ;;
      domains=*) DOMAINS="${opt#domains=}" ;;
    esac
  done
  ROUTES="${ROUTES//,/ }" DOMAINS="${DOMAINS//,/ }"
}

connect() {
  local ofv self
  ofv="$(command -v openfortivpn)" || { echo "openfortivpn not installed (macOS: brew install openfortivpn)" >&2; exit 1; }
  pick "$@"

  # 1. sudo password first, so its prompt doesn't race the browser
  sudo -v
  mkdir -p "$DIR"
  echo "$NAME ($GATEWAY)" >"$DIR/name"

  # 2. Start the root side detached; its output is the log
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  sudo -b nohup "$self" --run "$DIR" "$ofv" "$GATEWAY" "$ROUTES" "$DOMAINS" \
    </dev/null >"$DIR/log" 2>&1
  echo "Connecting to $NAME ($GATEWAY). Finish the login in your browser; Ctrl-C cancels."
  for _ in {1..100}; do running && break; sleep 0.1; done
  running || fail "failed to start"
  trap 'echo; stop || true; exit 130' INT

  # 3. SSO in the browser; the gateway redirects back to openfortivpn on 127.0.0.1:8020
  sleep 2
  local url="https://$GATEWAY/remote/saml/start?redirect=1"
  if [[ $OS == Linux ]]; then xdg-open "$url" >/dev/null 2>&1 || echo "Open: $url"; else open "$url"; fi

  # 4. Wait for routes + DNS
  until grep -q '^vpn: ready' "$DIR/log"; do
    running || fail "connection failed"
    sleep 1
  done
  trap - INT
  status
  echo "Runs in the background. 'vpn status' shows it; 'vpn stop' disconnects."
}

case "${1:-}" in
  --run) shift; root_main "$@" ;;
  status) status ;;
  stop) stop ;;
  *)
    if running; then
      status
      echo "Run 'vpn stop' first." >&2
      exit 1
    fi
    connect "$@"
    ;;
esac
