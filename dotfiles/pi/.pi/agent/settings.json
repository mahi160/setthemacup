{
  "theme": "gruvbox-material",
  "enableSkillCommands": true,
  "terminal": {
    "showTerminalProgress": false
  },
  "steeringMode": "all",
  "transport": "auto",
  "hideThinkingBlock": false,
  "markdown": {
    "mermaid": "final"
  },
  "showCacheMissNotices": false,
  "collapseChangelog": true,
  "quietStartup": true,
  "defaultProjectTrust": "ask",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "tuiMode": "regular",
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "auto",
  "defaultProvider": "anthropic",
  "defaultModel": "anthropic/claude-sonnet-5",
  "enabledModels": [
    "anthropic/claude-sonnet-5",
    "anthropic/claude-haiku-4-5",
    "anthropic/claude-opus-5"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 40000,
    "keepRecentTokens": 30000
  },
  "packages": [
    "npm:@signalridge/pi-plan-mode",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-lens",
    "npm:@upstash/context7-pi",
    "npm:pi-peon-adapter@1.1.0"
  ],
  "extensions": [
    "extensions/pi-focus/index.ts",
    "extensions/pi-claude/index.ts",
    "extensions/pi-spawn/index.ts",
    "extensions/pi-notify/index.ts",
    "extensions/pi-footer/index.ts",
    "extensions/pi-permissions/index.ts"
  ],
  "lastChangelogVersion": "0.85.1",
  "modelThinkingLevels": {
    "anthropic/claude-sonnet-5": "medium",
    "google/gemini-flash-lite-latest": "low"
  }
}