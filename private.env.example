# What the installer asks for once, then keeps in your private repo <you>/setthemacup-private
# (cloned to ~/.config/setthemacup/private.env). Read by the installer and ~/.zshenv.
# To set it up by hand instead: copy this to ~/.config/setthemacup/private.env and fill it in.
GIT_NAME="your-github-username"
GIT_EMAIL="you@example.com"
WORK_GIT_NAME=""                 # empty = no work identity or work SSH key
WORK_GIT_EMAIL=""
WORK_DIR="$HOME/Documents/Coding/Work"
NOTES_JOURNAL_DIR="$HOME/Documents/Notes/QuickNotes"
NOTES_PROJECT_DIR=""             # optional vault for LP:/WU: notes
# name=url pairs, space separated, e.g. "nas=smb://nas.local"
SMB_SHARES=""
# flowd journal: private repo for summaries, and this machine's folder in it
FLOWD_JOURNAL_REMOTE=""          # e.g. git@github.com:you/journal.git
FLOWD_MACHINE=""                 # e.g. macbook
# Work GitHub host alias + key file in ~/.ssh (clone work repos as git@<host>:org/repo.git)
WORK_SSH_HOST="work.github.com"
WORK_SSH_KEY="work_ed25519"
